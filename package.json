{
  "name": "adw-google-mcp",
  "version": "0.1.3",
  "description": "Google Workspace MCP server for Drive, Docs, Sheets, Calendar, Gmail, Slides, People, and Chat.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "adw-google-mcp": "build/index.js"
  },
  "files": [
    "build/index.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && tsc && node scripts/bundle.mjs && chmod +x build/index.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test build/tests/*.test.js",
    "test:consumer": "node scripts/test-consumer-package.mjs",
    "check": "npm run test && npm audit && npm run test:consumer",
    "tools": "npm run build --silent && node scripts/list-tools.mjs",
    "setup": "node build/index.js --setup",
    "prepack": "npm run check && node scripts/verify-package.mjs"
  },
  "keywords": [
    "mcp",
    "google-drive",
    "google-docs",
    "google-sheets",
    "google-calendar",
    "gmail",
    "google-slides",
    "google-contacts",
    "google-chat",
    "google-workspace",
    "model-context-protocol",
    "claude",
    "ai-tools"
  ],
  "author": "Arkady Dymkov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arkady-Dymkov/google-drive-mcp.git"
  },
  "homepage": "https://github.com/Arkady-Dymkov/google-drive-mcp#readme",
  "bugs": {
    "url": "https://github.com/Arkady-Dymkov/google-drive-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "css-select": "^7.0.0",
    "dom-serializer": "^3.1.1",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "googleapis-common": "8.0.1",
    "htmlparser2": "^12.0.0",
    "nodemailer": "^9.0.3",
    "open": "^11.0.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
